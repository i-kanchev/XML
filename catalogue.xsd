<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		   targetNamespace="http://www.w3schools.com"
		   xmlns="http://www.w3schools.com"
		   elementFormDefault="qualified">
	
	<xs:element name="catalogue">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="genres"/>	
				<xs:element ref="developers"/>
				<xs:element ref="publishers"/>
				<xs:element ref="platforms"/>
				<xs:element ref="games"/>
			</xs:sequence>
		</xs:complexType>
		
		<!-- genre key & keyref -->
		<xs:key name="genreKey">
			<xs:selector xpath="catalogue/genres/genre"/>
			<xs:field xpath="@id"/>
		</xs:key>
		
		<xs:keyref name="genreRef" refer="genreKey">
			<xs:selector xpath="catalogue/games/game/game_genres/game_genre"/>
			<xs:field xpath="@ref_genre_id"/>
		</xs:keyref>
		
		<!-- developer key & keyref -->
		<xs:key name="devKey">
			<xs:selector xpath="catalogue/developers/developer"/>
			<xs:field xpath="@id"/>
		</xs:key>
		
		<xs:keyref name="devRef" refer="devKey">
			<xs:selector xpath="catalogue/games/game/game_developer"/>
			<xs:field xpath="@ref_dev_id"/>
		</xs:keyref>
		
		<!-- publisher key & keyref -->
		<xs:key name="pubKey">
			<xs:selector xpath="catalogue/publishers/publisher"/>
			<xs:field xpath="@id"/>
		</xs:key>
		
		<xs:keyref name="pubRef" refer="pubKey">
			<xs:selector xpath="catalogue/games/game/game_publisher"/>
			<xs:field xpath="@ref_pub_id"/>
		</xs:keyref>
		
		<!-- platform key & keyref -->
		<xs:key name="platfKey">
			<xs:selector xpath="catalogue/platforms/platform"/>
			<xs:field xpath="@id"/>
		</xs:key>
		
		<xs:keyref name="platfRef" refer="platfKey">
			<xs:selector xpath="catalogue/games/game/game_platforms/game_platform"/>
			<xs:field xpath="@ref_platf_id"/>
		</xs:keyref>
		
	</xs:element>
	
	<xs:element name="genres">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="genre" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="id" type="xs:ID" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="developers">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="developer" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="id" type="xs:ID" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="publishers">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="publisher" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="id" type="xs:ID" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="platforms">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="platform" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="id" type="xs:ID" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="games">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="game" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="title" type="xs:string"/>
							<xs:element name="release_year" type="xs:integer"/>
							<xs:element name="game_developer">
								<xs:complexType>
									<xs:attribute name="ref_dev_id" type="xs:IDREF" use="required"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="game_publisher">
								<xs:complexType>
									<xs:attribute name="ref_pub_id" type="xs:IDREF" use="required"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="PEGI_rating" type="xs:string"/>
							<xs:element name="game_genres">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="game_genre" minOccurs="1" maxOccurs="unbounded">
											<xs:complexType>
												<xs:attribute name="ref_genre_id" type="xs:IDREF" use="required"/>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="game_platforms">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="game_platform" minOccurs="1" maxOccurs="unbounded">
											<xs:complexType>
												<xs:attribute name="ref_platf_id" type="xs:IDREF" use="required"/>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="logo">
							    <xs:complexType>
							        <xs:attribute name="href" type="xs:ENTITY" use="required"/>
							    </xs:complexType>
							</xs:element>
							<xs:element name="gallery">
							    <xs:complexType>
							        <xs:sequence>
							            <xs:element name="img" minOccurs="1" maxOccurs="4">
							                <xs:complexType>
							                    <xs:attribute name="href" type="xs:ENTITY" use="required"/>
							                </xs:complexType>
							            </xs:element>
							        </xs:sequence>
							    </xs:complexType>
							</xs:element>
							<xs:element name="description" type="xs:string"/>
						</xs:sequence>
						<xs:attribute name="id" type="xs:ID" use="required"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
</xs:schema>